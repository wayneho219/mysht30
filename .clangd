CompileFlags:
  Add: [--target=aarch64-linux-gnu]
  Remove: [-mabi=*, -fconserve-stack, -fno-allow-store-data-races, -femit-struct-debug-baseonly, -fcanon-prefix-map, -mstack-protector-guard*, -mbranch-protection*, -fmacro-prefix-map*, -fdebug-prefix-map*, -fstrict-flex-arrays*, -Wa*, -fno-var-tracking]
